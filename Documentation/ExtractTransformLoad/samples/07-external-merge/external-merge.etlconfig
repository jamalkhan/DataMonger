{
  // 07-external-merge: the same kind of nested feed, joined with the disk-backed externalMerge strategy.
  // The primary and each direct child are external-sorted by their join key and merge-joined in one pass,
  // so memory use does not grow with file size. Consequences you can see in the output:
  //   - records come out in join-key order (ordinal string order), NOT in source-file order
  //   - levels below the top (order -> lines) are indexed in memory
  //   - a composite key (customer_id + brand) works
  "version": 1,
  "run": { "joinStrategy": "externalMerge", "onError": "skip" },

  "sources": {
    "customers":   { "file": "customers_shuffled.csv" },
    "orders":      { "file": "../data/orders.csv" },
    "order_lines": { "file": "../data/order_lines.csv" },
    "emails":      { "file": "../data/emails.csv" },
    "email_prefs": { "file": "../data/email_prefs.csv" }
  },

  "outputs": [
    {
      "name": "customers_external",
      "mode": "object",
      "source": "customers",
      "fields": [
        { "name": "customer_id", "from": "customer_id", "type": "integer" },
        { "name": "last_name",   "from": "last_name",   "type": "string" }
      ],
      "children": [
        { "source": "orders", "as": "orders", "cardinality": "many",
          "on": { "parent": "customer_id", "child": "customer_id" },
          "fields": [ { "name": "order_id", "from": "order_id", "type": "integer" } ],
          "children": [
            { "source": "order_lines", "as": "lines", "cardinality": "many",
              "on": { "parent": "order_id", "child": "order_id" },
              "fields": [ { "name": "sku", "from": "sku", "type": "string" } ] }
          ] },
        { "source": "emails", "as": "emails", "cardinality": "many",
          "on": { "parent": "customer_id", "child": "customer_id" },
          "fields": [ { "name": "email_address", "from": "email_address", "type": "string" } ] }
      ],
      "load": { "folder": "output", "fileBaseName": "customers_external", "sampling": { "enabled": false } }
    },
    {
      // Composite (two-column) join: match an email row to its preference row on customer AND brand.
      "name": "email_with_prefs",
      "mode": "object",
      "source": "emails",
      "fields": [
        { "name": "customer_id",   "from": "customer_id",   "type": "integer" },
        { "name": "email_address", "from": "email_address", "type": "string" },
        { "name": "brand",         "from": "brand",         "type": "string" }
      ],
      "children": [
        { "source": "email_prefs", "as": "prefs", "cardinality": "one",
          "on": { "parents": [ "customer_id", "brand" ], "children": [ "customer_id", "brand" ] },
          "fields": [
            { "name": "channel",  "from": "channel",  "type": "string" },
            { "name": "opted_in", "from": "opted_in", "type": "bool" }
          ] }
      ],
      "load": { "folder": "output", "fileBaseName": "email_with_prefs", "sampling": { "enabled": false } }
    }
  ]
}

{
  // 09-run-limits (max-records): run.maxRecords stops after 5 records; load.splitEvery rolls to a new file every 2 records.
  "version": 1,
  "run": { "joinStrategy": "hashInMemory", "onError": "skip", "maxRecords": 5 },

  "sources": {
    "customers": { "file": "../data/customers.csv" },
    "orders":    { "file": "../data/orders.csv" },
    "emails":    { "file": "../data/emails.csv" }
  },

  "outputs": [
    {
      "name": "customers",
      "mode": "object",
      "source": "customers",
      "fields": [
        { "name": "customer_id", "from": "customer_id", "type": "integer" },
        { "name": "last_name",   "from": "last_name",   "type": "string" },
        { "name": "email_addresses", "type": "array",
          "lookup": { "source": "emails", "on": { "parent": "customer_id", "child": "customer_id" }, "column": "email_address", "distinct": true } }
      ],
      "children": [
        { "source": "orders", "as": "orders", "cardinality": "many",
          "on": { "parent": "customer_id", "child": "customer_id" },
          "fields": [ { "name": "order_id", "from": "order_id", "type": "integer" } ] }
      ],
      "load": { "folder": "output", "fileBaseName": "customers", "splitEvery": 2, "sampling": { "enabled": false } }
    }
  ]
}

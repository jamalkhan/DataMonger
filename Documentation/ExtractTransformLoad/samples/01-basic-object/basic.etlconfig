{
  // 01-basic-object: one JSON object per customer row.
  // Demonstrates: typed input fields, output types, a few pipelines, omitted empty values.
  "version": 1,
  "run": { "joinStrategy": "hashInMemory", "onError": "skip" },

  "sources": {
    "customers": {
      "file": "../data/customers.csv",
      "format": "delimited",
      "delimiter": "csv",
      "fields": {
        "customer_id":    { "type": "integer" },
        "birth_date":     { "type": "date", "format": "yyyy-MM-dd" },
        "signup_ts":      { "type": "datetime", "format": "yyyy-MM-dd HH:mm:ss", "culture": "en-US" },
        "lifetime_spend": { "type": "decimal" }
      }
    }
  },

  "outputs": [
    {
      "name": "customers",
      "mode": "object",
      "source": "customers",
      "fields": [
        { "name": "customer_id", "from": "customer_id", "type": "integer" },
        { "name": "first_name",  "from": "first_name",  "type": "string" },
        { "name": "middle_name", "from": "middle_name", "type": "string" },
        { "name": "last_name",   "from": "last_name",   "type": "string" },
        { "name": "full_name",   "type": "string",
          "pipeline": [ { "op": "concat", "values": [ { "field": "first_name" }, { "field": "last_name" } ], "separator": " " } ] },
        { "name": "email",       "from": "email", "type": "string", "pipeline": [ { "op": "lower" } ] },
        { "name": "birth_date",  "from": "birth_date", "type": "date" },
        { "name": "signed_up_at","from": "signup_ts",  "type": "datetime" },
        { "name": "is_member",   "from": "is_member",  "type": "bool" },
        { "name": "lifetime_spend", "from": "lifetime_spend", "type": "decimal" },
        { "name": "spend_with_tax", "from": "lifetime_spend", "type": "decimal",
          "pipeline": [ { "op": "multiply", "rhs": { "literal": 1.08 } } ] }
      ],
      "load": {
        "format": "jsonl",
        "folder": "output",
        "fileBaseName": "customers",
        "sampling": { "enabled": false }
      }
    }
  ]
}

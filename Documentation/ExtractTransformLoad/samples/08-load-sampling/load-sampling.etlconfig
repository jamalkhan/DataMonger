{
  // 08-load-sampling: the two "eyeball" sample features under load.
  //  - sampling:     a uniform RANDOM sample of N records, each written as its own pretty-printed JSON file
  //                  (ON by default; shown here with a custom count/folder/file-name fields)
  //  - richSampling: the N most fully populated records (most non-empty nested relations); deterministic
  // Both are in addition to the normal JSONL feed, which still contains every record.
  "version": 1,
  "run": { "joinStrategy": "hashInMemory", "onError": "skip" },

  "sources": {
    "customers": { "file": "../data/customers.csv", "fields": { "customer_id": { "type": "integer" } } },
    "orders":    { "file": "../data/orders.csv" },
    "emails":    { "file": "../data/emails.csv" }
  },

  "outputs": [
    {
      "name": "customers",
      "mode": "object",
      "source": "customers",
      "fields": [
        { "name": "customer_id", "from": "customer_id", "type": "integer" },
        { "name": "first_name",  "from": "first_name",  "type": "string" },
        { "name": "last_name",   "from": "last_name",   "type": "string" }
      ],
      "children": [
        { "source": "orders", "as": "orders", "cardinality": "many", "limit": 2,   // limit: at most 2 orders per customer
          "on": { "parent": "customer_id", "child": "customer_id" },
          "fields": [ { "name": "order_id", "from": "order_id", "type": "integer" } ] },
        { "source": "emails", "as": "emails", "cardinality": "many",
          "on": { "parent": "customer_id", "child": "customer_id" },
          "fields": [ { "name": "email_address", "from": "email_address", "type": "string" } ] }
      ],
      "load": {
        "format": "jsonl",
        "folder": "output",
        "fileBaseName": "customers",
        "sampling": {
          "enabled": true,
          "count": 2,
          "folder": "random-sample",
          "fileNameFields": [ "customer_id", "last_name" ]
        },
        "richSampling": {
          "enabled": true,
          "count": 2,
          "folder": "richest-records",
          "fileNameFields": [ "customer_id", "last_name" ]
        }
      }
    }
  ]
}
